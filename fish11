local FILE_NAME = "JENTZ_6_STAGE_AUTH_EXPIRE.json"
local SCRIPT_URL = "https://raw.githubusercontent.com/chinzhuoxuan3-byte/Mls111/refs/heads/main/Ezzloljentzol"
local EXPIRE_TIME = 86400 -- 24小时有效期

local function CheckAuth()
    if isfile and isfile(FILE_NAME) then
        local success, content = pcall(readfile, FILE_NAME)
        if success then
            local data = HttpService:JSONDecode(content)
            if data.User == LocalPlayer.Name and data.Pass == true then
                local currentTime = os.time()
                local authTime = data.Time or 0
                if (currentTime - authTime) < EXPIRE_TIME then
                    return true
                end
            end
        end
    end
    return false
end

if CheckAuth() then
    loadstring(game:HttpGet(SCRIPT_URL))()
    return
end

