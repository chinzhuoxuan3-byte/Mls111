local currentStage = 1
local stages = {
    {q = "阶段 1: 安全密钥", check = function(txt) return txt == "jentz" end, err = "访问被拒绝"},
    {q = "阶段 2: 身份识别 (你的用户名)", check = function(txt) return txt == LocalPlayer.Name end, err = "用户名不匹配"},
    {q = "阶段 3: 计算题 (350234 + 0)", check = function(txt) return txt == "350234" end, err = "计算错误"},
    {q = "阶段 4: 作者帅不帅?", check = function(txt) return txt == "帅" end, err = "回答错误 (必须是: 帅)"},
    {q = "阶段 5: 你是谁?", check = function(txt) return #txt > 0 end, err = "内容不能为空"},
    {q = "阶段 6: jentz hub作者", check = function(txt) return txt == "manbaout" end, err = "作者ID错误"}
}

local function UpdateUI()
    local stageData = stages[currentStage]
    QuestionLabel.Text = stageData.q
    InputBox.Text = ""
    InputBox.PlaceholderText = "等待输入..."
    TweenService:Create(ProgressLine, TweenInfo.new(0.3), {Size = UDim2.new((currentStage-1)/6, 0, 0, 2)}):Play()
end

local function Shake()
    local currentPos = Main.Position
    for i = 1, 4 do
        Main.Position = UDim2.new(currentPos.X.Scale, currentPos.X.Offset + math.random(-5,5), currentPos.Y.Scale, currentPos.Y.Offset + math.random(-5,5))
        task.wait(0.05)
    end
    Main.Position = currentPos
end

SubmitBtn.MouseButton1Click:Connect(function()
    local input = InputBox.Text
    local stageData = stages[currentStage]
    
    if stageData.check(input) then
        local originalColor = InputStroke.Color
        TweenService:Create(InputStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(100, 255, 100)}):Play()
        task.wait(0.2)
        TweenService:Create(InputStroke, TweenInfo.new(0.2), {Color = originalColor}):Play()
        
        currentStage = currentStage + 1
        
        if currentStage > 6 then
            TweenService:Create(ProgressLine, TweenInfo.new(0.3), {Size = UDim2.new(1, 0, 0, 2)}):Play()
            Title.Text = "验证通过"
            Title.TextColor3 = Color3.fromRGB(100, 255, 100)
            task.wait(0.5)
            
            local authData = {
                User = LocalPlayer.Name, 
                Pass = true, 
                Time = os.time()
            }
            writefile(FILE_NAME, HttpService:JSONEncode(authData))
            
            TweenService:Create(Main, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Size = UDim2.new(0, 0, 0, 0)}):Play()
            task.wait(0.5)
            Gui:Destroy()
            loadstring(game:HttpGet(SCRIPT_URL))()
        else
            UpdateUI()
        end
    else
        InputBox.Text = ""
        InputBox.PlaceholderText = stageData.err
        Shake()
    end
end)

UpdateUI()

local dragging, dragInput, dragStart, startPos
Main.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true dragStart = input.Position startPos = Main.Position
    end
end)
game:GetService("UserInputService").InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
game:GetService("UserInputService").InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
end)

