local function CreateSlot(i)
    local btn = Instance.new("TextButton", SlotContainer)
    btn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    btn.Text = "槽位 " .. i
    btn.TextColor3 = Color3.fromRGB(150, 150, 150)
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 9
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
    
    local stroke = Instance.new("UIStroke", btn)
    stroke.Color = Color3.fromRGB(60, 60, 60)
    stroke.Thickness = 1
    
    btn.MouseButton1Click:Connect(function()
        Selected[i] = (Selected[i] % #AttrNames) + 1
        local name = AttrNames[Selected[i]]
        btn.Text = name
        
        if Selected[i] ~= 1 then
            btn.BackgroundColor3 = Color3.fromRGB(50, 45, 25)
            btn.TextColor3 = Color3.fromRGB(255, 220, 100)
            stroke.Color = Color3.fromRGB(200, 160, 50)
        else
            btn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
            btn.TextColor3 = Color3.fromRGB(150, 150, 150)
            stroke.Color = Color3.fromRGB(60, 60, 60)
        end
    end)
end

for i = 1, 4 do CreateSlot(i) end

