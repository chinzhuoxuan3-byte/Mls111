local function ParseValue(s)
    s = s:lower():gsub("%s+", ""):gsub(",", "")
    local n, suf = s:match("([%d%.]+)(%a*)")
    if not n then return 0 end
    local mults = {k=1e3, m=1e6, b=1e9, t=1e12}
    return (tonumber(n) or 0) * (mults[suf] or 1)
end

local function FormatValue(v)
    if v >= 1e9 then return string.format("%.3fB", v/1e9)
    elseif v >= 1e6 then return string.format("%.3fM", v/1e6)
    elseif v >= 1e3 then return string.format("%.1fK", v/1e3)
    else return tostring(math.floor(v)) end
end

CalcBtn.MouseButton1Click:Connect(function()
    local base = ParseValue(BaseInput.Text)
    local totalBonus = 0
    for _, idx in ipairs(Selected) do
        totalBonus = totalBonus + (AttrData[AttrNames[idx]] - 1)
    end
    local finalPrice = base * (1 + totalBonus)
    Result.Text = "结果: " .. FormatValue(finalPrice) .. "\n(x" .. (1+totalBonus) .. ")"
end)

