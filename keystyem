        local oldColor = Stroke.Color
        TweenService:Create(Stroke, TweenInfo.new(0.1), {Color = Color3.fromRGB(0, 255, 100)}):Play()
        task.wait(0.2)
        TweenService:Create(Stroke, TweenInfo.new(0.2), {Color = oldColor}):Play()
        
        currentStage = currentStage + 1
        
        if currentStage > 25 then
            local authData = {User = LocalPlayer.Name, Pass = true, Time = os.time()}
            writefile(FILE_NAME, HttpService:JSONEncode(authData))
