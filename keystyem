        else
            UpdateUI()
        end
    else
        totalFailures = totalFailures + 1
        
        if totalFailures > 25 then
            FakeKickEffect()
        else
            InputBox.Text = ""
            InputBox.PlaceholderText = "错误! 题目已重置"
            
            local oldColor = Stroke.Color
            TweenService:Create(Stroke, TweenInfo.new(0.1), {Color = Color3.fromRGB(255, 0, 0)}):Play()
            ShakeEffect()
            TweenService:Create(Stroke, TweenInfo.new(0.5), {Color = oldColor}):Play()
            
            -- 核心：重新从 100 题中随机抽 25 题
            ShuffleAndSelect()
            UpdateUI()
        end
    end
end)

