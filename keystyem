local function ShowSuccessAndLoad(targetGui)
    local SuccessLabel = Instance.new("TextLabel")
    SuccessLabel.Parent = targetGui
    SuccessLabel.AnchorPoint = Vector2.new(0.5, 0.5)
    SuccessLabel.Position = UDim2.new(0.5, 0, 0.5, 0)
    SuccessLabel.Size = UDim2.new(0, 0, 0, 0)
    SuccessLabel.BackgroundTransparency = 1
    SuccessLabel.Text = "不过如此"
    SuccessLabel.TextColor3 = Color3.fromRGB(0, 255, 255)
    SuccessLabel.Font = Enum.Font.GothamBlack
    SuccessLabel.ZIndex = 100
    
    local MainFrame = targetGui:FindFirstChild("Main")
    if MainFrame then
        TweenService:Create(MainFrame, TweenInfo.new(0.4), {Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1}):Play()
    end

    local t1 = TweenService:Create(SuccessLabel, TweenInfo.new(0.8, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, 100), TextSize = 40})
    t1:Play()
    t1.Completed:Wait()
    task.wait(0.5)
    targetGui:Destroy()
end

local function CheckAuth()
    if isfile and isfile(FILE_NAME) then
        local success, content = pcall(readfile, FILE_NAME)
        if success then
            local data = HttpService:JSONDecode(content)
            if data.User == LocalPlayer.Name and data.Pass == true then
                local currentTime = os.time()
                local authTime = data.Time or 0
                if (currentTime - authTime) < EXPIRE_TIME then
                    return true
                end
            end
        end
    end
    return false
end

if CheckAuth() then return end

