local function ShuffleAndSelect()
    -- 1. 先把整个 Pool 洗乱
    for i = #Pool, 2, -1 do
        local j = math.random(i)
        Pool[i], Pool[j] = Pool[j], Pool[i]
    end
    
    -- 2. 清空当前关卡列表
    SelectedStages = {}
    
    -- 3. 抽取前 25 题
    for i = 1, 25 do
        table.insert(SelectedStages, Pool[i])
    end
    
    -- 4. 重置进度
    currentStage = 1
end

ShuffleAndSelect()

